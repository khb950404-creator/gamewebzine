# 무료 옵션 1: Google Gemini 무료 티어 (https://aistudio.google.com/apikey 에서 발급, 카드 불필요)
LLM=gemini
GEMINI_API_KEY=여기에_키_입력
# GEMINI_MODEL=gemini-flash-latest

# 무료 옵션 2: 로컬 Ollama (https://ollama.com 설치 후 `ollama pull qwen2.5:7b`)
# LLM=ollama
# OLLAMA_MODEL=qwen2.5:7b

MAX_ARTICLES=8

# 루머 기사는 항상 검수 대기. 1이면 모든 기사를 검수 대기로
REVIEW_ALL=0

# 사이트 정보 / 애드센스 (승인 후 입력. 비워두면 광고 자리만 표시)
CONTACT_EMAIL=
ADSENSE_CLIENT=
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_ARTICLE=
